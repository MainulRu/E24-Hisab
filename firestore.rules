rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return signedIn()
        && request.auth.uid == 'exITNpwyRNaWpoMW6BgMcMGbf2';
    }

    match /users/{userId} {
      // Users can read their own profile; only Main Admin can list all profiles.
      allow get: if signedIn() && (request.auth.uid == userId || isMainAdmin());
      allow list: if isMainAdmin();

      // A user may create/update only their basic profile fields.
      // Admin status is never stored in an editable profile field.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string;

      allow update: if isMainAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']));

      allow delete: if isMainAdmin();

      match /data/{documentId} {
        // Every account reads/writes its own ledger. Main Admin can manage all ledgers.
        allow read, write: if signedIn()
          && (request.auth.uid == userId || isMainAdmin());
      }
    }
  }
}